{
  "name": "ai-core",
  "version": "0.1.0",
  "private": true,
  "description": "ai-core framework: players, characters, money, jobs, permissions, admin panel",
  "license": "GPL-3.0-only",
  "author": {
    "name": "TGIANN"
  },
  "repository": "github:aifivem/ai-core",
  "type": "module",
  "fxDependencies": [
    "/onesync",
    "/server:38039"
  ],
  "scripts": {
    "lint": "oxlint --ignore-pattern \"dist/**\" --ignore-pattern \"web/postcss-*.js\"",
    "format": "prettier --write .",
    "dev": "bun tsdown -- --watch",
    "webdev": "bun --cwd web vite",
    "build": "bun run --cwd web build && aicore-db-types && bun tsdown -- && aicore-client-errors dist/client.js",
    "typecheck": "tsc --noEmit -p resource/client/tsconfig.json && tsc --noEmit -p resource/server/tsconfig.json"
  },
  "dependencies": {
    "@aicore-fivem/lib": "^0.1.0",
    "@aicore-fivem/shared": "^0.1.0",
    "@aicore-fivem/mysql": "^0.1.0"
  },
  "devDependencies": {
    "@aicore-fivem/build": "^0.1.0",
    "@citizenfx/client": "latest",
    "@citizenfx/server": "latest",
    "@types/bun": "latest",
    "@types/node": "^22",
    "fast-glob": "^3.3.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "oxlint": "^1.66.0",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3"
  },
  "fxServerScripts": [
    "bridge/core/lib.lua",
    "bridge/lib/init.lua",
    "bridge/core/shapes.lua",
    "bridge/core/server.lua",
    "bridge/qb/server.lua",
    "bridge/qbx/server.lua",
    "bridge/esx/server.lua",
    "bridge/esx/shared.lua"
  ],
  "fxClientScripts": [
    "bridge/core/lib.lua",
    "bridge/lib/init.lua",
    "bridge/core/shapes.lua",
    "bridge/core/client.lua",
    "bridge/core/ui.lua",
    "bridge/qb/client.lua",
    "bridge/qb/ui.lua",
    "bridge/qbx/client.lua",
    "bridge/esx/client.lua",
    "bridge/esx/shared.lua",
    "bridge/esx/game.lua",
    "bridge/esx/ui.lua"
  ],
  "fxProvide": [
    "es_extended",
    "qb-core",
    "qbx_core",
    "esx_context",
    "esx_textui",
    "esx_notify",
    "esx_progressbar",
    "esx_menu_default",
    "esx_menu_dialog",
    "esx_menu_list",
    "qb-menu",
    "qb-input",
    "progressbar"
  ],
  "fxFiles": [
    "data/keybinds.json",
    "data/jobs.json",
    "data/gangs.json",
    "modules/playerdata.lua",
    "bridge/lib/lua/client/*.lua",
    "bridge/lib/lua/shared/*.lua",
    "shared/locale.lua",
    "imports.lua",
    "locale.lua"
  ]
}
